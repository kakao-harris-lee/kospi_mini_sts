# KOSPI Mini 데이터 수집기 환경 변수 설정
# 이 파일을 .env로 복사하고 실제 값을 입력하세요

# ============================================================
# 한국투자증권 Open API 설정
# https://apiportal.koreainvestment.com 에서 발급
# ============================================================
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=12345678-01

# 실전투자 여부 (true: 실전, false: 모의)
KIS_IS_REAL=false

# ============================================================
# ClickHouse 데이터베이스 설정
# ============================================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=kospi
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# ============================================================
# Polygon.io API 설정 (ES 선물 데이터 수집용, 선택사항)
# ============================================================
POLYGON_API_KEY=
POLYGON_RATE_LIMIT=5
