# Trading System Environment Configuration
# 복사 후 .env로 이름 변경하여 사용
# cp .env.example .env

# ============================================================
# 한국투자증권 API 설정
# ============================================================
KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret
KIS_ACCOUNT_NO=12345678-01      # 계좌번호 (8자리-2자리)
KIS_MARKET=real                  # real: 실전투자, mock: 모의투자

# ============================================================
# 선물 코드 (선택)
# ============================================================
# 빈 값이면 근월물 자동 계산
# 형식: 101{월코드}{년도} (예: 101F26 = 2026년 1월물)
FUTURES_CODE=

# ============================================================
# Redis 설정
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================
# ClickHouse 설정
# ============================================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=trading_db
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ============================================================
# 전략 설정 (Phase 8.1)
# ============================================================
# 전략 선택
# pure_micro: 순수 마이크로스트럭처 (추천)
# adaptive_micro: 적응형 마이크로스트럭처
# mean_reversion, breakout, ofi_momentum, hybrid: 레거시
STRATEGY=pure_micro

# ============================================================
# 모델 설정 (LSTM - deprecated in Phase 8)
# ============================================================
MODEL_PATH=models/trading_lstm.pth
MODEL_DEVICE=auto  # auto, cuda, mps, cpu

# ============================================================
# 운영 설정
# ============================================================
LOG_LEVEL=INFO
DRY_RUN=true  # true: 실제 주문 없음, false: 실제 주문 실행
STRATEGY_TRADE_ALERTS=true  # 전략 매매 알림 (Telegram)

# ============================================================
# Telegram 알림 설정
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHECK_TRADING_DAY=true

# ============================================================
# 모니터링 설정 (Phase 8.5)
# ============================================================
# docker-compose --profile monitoring 사용 시
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
