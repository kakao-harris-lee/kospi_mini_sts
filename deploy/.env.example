# =============================================================================
# KOSPI Trading System - 환경 설정 예시
# 이 파일을 .env로 복사하여 사용하세요
# =============================================================================

# 한국투자증권 API
KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=your_account_number
KIS_MARKET=real  # real 또는 mock

# Redis (서버에 이미 설치됨)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=@1tidh6ls6ls

# ClickHouse (서버에 이미 설치됨)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=kospi
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=@1tidh6ls6ls

# 전략 설정
DRY_RUN=true              # true: 모의 주문, false: 실제 주문
STRATEGY=pure_micro       # pure_micro, adaptive_micro, hybrid

# 선물 코드 (비워두면 자동 계산)
FUTURES_CODE=

# 로깅
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR

# 메트릭 (Prometheus)
METRICS_PORT=8080
