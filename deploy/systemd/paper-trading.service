[Unit]
Description=KOSPI Mini Paper Trading Service
Documentation=https://github.com/your-repo/kospi-trading
After=network.target redis-server.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/project/kospi_mini_sts
EnvironmentFile=/home/deploy/project/kospi_mini_sts/.env
ExecStart=/home/deploy/project/kospi_mini_sts/venv/bin/python scripts/paper_trading_service.py --strategy pure_micro
Restart=always
RestartSec=10

# 로깅
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paper-trading

# 리소스 제한
MemoryMax=512M
CPUQuota=50%

# 보안 설정
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/deploy/project/kospi_mini_sts/logs
ReadWritePaths=/home/deploy/project/kospi_mini_sts/pids

[Install]
WantedBy=multi-user.target
