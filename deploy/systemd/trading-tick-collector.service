[Unit]
Description=KOSPI Trading - Tick Collector
Documentation=https://github.com/your-repo/kospi-trading
After=network.target redis-server.service clickhouse-server.service
Wants=redis-server.service clickhouse-server.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/project/kospi_mini_sts
EnvironmentFile=/home/deploy/project/kospi_mini_sts/.env
ExecStart=/home/deploy/project/kospi_mini_sts/venv/bin/python -m src.collector.tick_collector
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-tick-collector

# 리소스 제한
MemoryMax=1G
CPUQuota=50%

# 보안 설정
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/deploy/project/kospi_mini_sts/logs

[Install]
WantedBy=multi-user.target
