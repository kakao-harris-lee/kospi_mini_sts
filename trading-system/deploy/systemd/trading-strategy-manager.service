[Unit]
Description=KOSPI Trading - Strategy Manager
Documentation=https://github.com/your-repo/kospi-trading
After=network.target redis-server.service trading-feature-processor.service
Wants=redis-server.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/trading-system
EnvironmentFile=/home/deploy/trading-system/.env
ExecStart=/home/deploy/trading-system/venv/bin/python -m src.strategy.strategy_manager
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-strategy-manager

# 리소스 제한
MemoryMax=512M
CPUQuota=30%

# 보안 설정
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/deploy/trading-system/logs

[Install]
WantedBy=multi-user.target
