[Unit]
Description=KOSPI Trading - DB Logger
Documentation=https://github.com/your-repo/kospi-trading
After=network.target redis-server.service clickhouse-server.service
Wants=redis-server.service clickhouse-server.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/trading-system
EnvironmentFile=/home/deploy/trading-system/.env
ExecStart=/home/deploy/trading-system/venv/bin/python -m src.db_logger.db_logger
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-db-logger

# 리소스 제한
MemoryMax=256M
CPUQuota=20%

# 보안 설정
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/deploy/trading-system/logs

[Install]
WantedBy=multi-user.target
